# The harness talks to any OpenAI-compatible chat-completions endpoint -- all three
# variables below are required, nothing is hardcoded to a specific provider in code.
#
# Example values here point at Gemini's OpenAI-compatibility endpoint (free tier key:
# https://aistudio.google.com/apikey). To use a different provider (OpenAI itself,
# Azure OpenAI, a local vLLM/Ollama server, etc.), just change these three values --
# no code changes needed.

LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.1-flash-lite
